NODE_ENV=
PORT=
MONGODB_URI=

# Auth
JWT_SECRET=
ACCESS_TOKEN_EXPIRES_IN=7d

# CORS (comma separated list of allowed frontend origins)
FRONTEND_URL=
CORS_ORIGINS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Send an in-app notification to every active user when a course is created/updated/deleted (default: off)
COURSE_NOTIFICATIONS=false

# Google Sign-In (same OAuth Web client ID as VITE_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=

